# ─── Servidor API (copia a .env en dental-app/) ───
PORT=3002
TZ=America/Mexico_City
CORS_ORIGIN=http://localhost:5173

# Base de datos local (SQLite — open source)
DB_FILE=appointments.sqlite

# Panel administrador (/admin) — login estático en el frontend
ADMIN_PASSWORD=ds-admin-2026
ADMIN_SESSION_KEY=ds-admin-authenticated
ADMIN_SESSION_HOURS=8

# Mismos valores en el frontend (Vite)
VITE_ADMIN_PASSWORD=ds-admin-2026
VITE_ADMIN_SESSION_KEY=ds-admin-authenticated

# Clínica
CLINIC_NAME=DS Dental Aesthetics
DOCTOR_NAME=Dr. Daniel Sarmiento
CLINIC_PHONE=961-254-4233
CLINIC_WHATSAPP=529612544233
CLINIC_ADDRESS=Cintalapa, Chiapas, México
CLINIC_MAPS_QUERY=DS Dental Aesthetics, Cintalapa, Chiapas, México

# Horario laboral (días: 0=Dom, 1=Lun … 6=Sáb)
WORK_DAYS=1,2,3,4,5,6
WORK_START_HOUR=9
WORK_END_HOUR=18
SATURDAY_END_HOUR=14
SLOT_MINUTES=60

# Twilio WhatsApp (opcional — si no configuras, se usa enlace wa.me)
# Obtén credenciales en https://console.twilio.com/ — no uses valores reales aquí
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_FROM=whatsapp:+1234567890

# Frontend
# GitHub Pages: base del repo (ej. /DentalS/) — solo al hacer build para Pages
# VITE_BASE_PATH=/DentalS/
# API en producción (Render, Railway, etc.) — vacío = mismo origen o proxy local
VITE_API_URL=
